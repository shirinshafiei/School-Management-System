version: '3.8'

services:
  db:
    image: postgis/postgis:latest
    container_name: eduplatform_db
    environment:
      - POSTGRES_DB=eduplatform
      - POSTGRES_USER=admin
      - POSTGRES_PASSWORD=48314831@Sh
    volumes:
      - postgres_data:/var/lib/postgresql/data/
    ports:
      - "5432:5432"
    healthcheck:  # ADD THIS
      test: ["CMD-SHELL", "pg_isready -U admin -d eduplatform"]
      interval: 5s
      timeout: 5s
      retries: 10

  web:
    build: .
    container_name: eduplatform_web
    command: python manage.py runserver 0.0.0.0:8000
    volumes:
      - .:/app
    ports:
      - "8000:8000"
    environment:
      - DATABASE_URL=postgresql://admin:48314831@Sh@db:5432/eduplatform
    depends_on:  # MODIFY THIS
      db:
        condition: service_healthy
    stdin_open: true
    tty: true

volumes:
  postgres_data: